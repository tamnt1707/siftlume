{
  "name": "siftlume",
  "description": "Siftlume: a Chrome extension that sifts web pages, text and files into visual, interactive summaries with OpenUI. Bring your own LLM key.",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "check:i18n": "node scripts/check-locales.mjs",
    "check:examples": "tsx scripts/check-examples.ts",
    "check": "pnpm compile && pnpm check:i18n && pnpm check:examples",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "@openuidev/react-lang": "^1.1.0",
    "@openuidev/react-ui": "^0.18.4",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "ai": "^7.0.163",
    "cmdk": "^1.1.1",
    "i18next": "^26.7.2",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438",
    "pele": "^1.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.1.13",
    "turndown": "^7.2.5",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.6",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "license": "MIT",
  "author": "tamnt1707",
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/tamnt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamnt1707/siftlume.git"
  },
  "homepage": "https://github.com/tamnt1707/siftlume#readme",
  "bugs": {
    "url": "https://github.com/tamnt1707/siftlume/issues"
  }
}
