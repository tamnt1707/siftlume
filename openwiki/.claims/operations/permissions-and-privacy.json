        }
      ]
    },
    {
      "id": "claim_5eb5e345a6504bcd819ab1f4841532cf",
      "statement": "API keys are stored only in `chrome.storage.local` and are never synced: `settingsItem` is defined with the `local:` prefix and an explicit comment stating the reason, and the same holds for the persisted history (`local:history`) and the model cache (`local:modelCache`).",
      "evidence": [
        {
          "resource": "repo://lib/history.ts#L50-L52",
          "version": "repo-lines-v1:sha256:e4368d0de738100bb5d495da6fb1c3eec5f73dc5d5ca3100f14ebb66569e089d:"
