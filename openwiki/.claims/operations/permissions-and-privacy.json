          "version": "repo-lines-v1:sha256:d1ec66a25beb96b77f787fb8045125befba116b8c7dc5e07fa653948133f39e7:"
        }
      ]
    },
    {
      "id": "claim_5cb989b1120a4bffa7c765fec647b8f7",
      "statement": "`lib/page.ts` still refuses URLs the browser itself blocks (`chrome:`, `edge:`, `about:`, `chrome-extension:`, `devtools:`, `view-source:` and the Chrome Web Store) via the `RESTRICTED` pattern and `isReadableUrl`, and the popup disables its \"Summarize this page\" action for such tabs.",
      "evidence": [
        {
          "resource": "repo://entrypoints/popup/Popup.tsx#L30-L36",
          "version": "repo-lines-v1:sha256:5a940a9bcd0e15f2f719e0a6f95eaf1b33d4f7634021db3664700831e7a9bdc8:"
