    },
    {
      "id": "claim_dd4571c3e8be450aacded5aad04d2b68",
      "statement": "There is no backend: `lib/llm.ts` builds an AI SDK model bound to the user's own base URL and API key and streams it directly from the extension page, so the only outbound traffic is the provider request and the provider's model-list request, carrying the user's key and the extracted source text.",
      "evidence": [
        {
          "resource": "repo://lib/llm.ts#L40-L60",
          "version": "repo-lines-v1:sha256:e217fbae5d99fbed8e2553d119579600ce39f29976bce38175e4dfd63df1601c:"
