    {
      "id": "claim_614c2d6da79d4c4d885b60ac487e987c",
      "statement": "Page reading is authorised by `activeTab` plus `scripting`: `lib/page.ts` reads a tab via `browser.scripting.executeScript` (returning `document.documentElement.outerHTML`) and injects a highlighter function the same way, and the grant comes implicitly from the toolbar click and the context-menu click on that tab rather than from a host permission or a prompt.",
      "evidence": [
        {
          "resource": "repo://entrypoints/background.ts#L54-L76",
          "version": "repo-lines-v1:sha256:4c9982bc4bc1a43365af857725e24d5a569d07914867c698c4a394818681ebe4:"
        },
        {
          "resource": "repo://lib/page.ts#L30-L55",
          "version": "repo-lines-v1:sha256:fbc5cb80307b3ad6d791db9b15306e2b24c3bd147758ad951ac9f77215786a71:"
        },
        {
