    {
      "id": "claim_4c7421f6494a4123866c1d4fac7d29fb",
      "statement": "The handoff of pending summarize requests is deliberately non-durable: `lib/pending.ts` stores queued requests, the per-tab panel pointer and the per-tab panel URLs under `session:` keys (`chrome.storage.session`, memory only), so pasted or selected text never travels in a URL and does not outlive the browser session; `lib/history.ts` separately keeps at most 20 sessions locally.",
      "evidence": [
        {
          "resource": "repo://lib/history.ts#L49-L52",
          "version": "repo-lines-v1:sha256:fae2cff0c32433d6c0294e992a87a393d031507ea6cb5761034649f752ecc796:"
