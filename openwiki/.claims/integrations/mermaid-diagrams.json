  "claims": [
    {
      "id": "claim_c1e654925b2340c7982dc2bf9e9e6f23",
      "statement": "The extension renders model-authored Mermaid diagrams client-side with Pele (imported from `pele/lazy`), so the model only contributes text and the SVG is produced in the browser without network calls or eval.",
      "evidence": [
        {
          "resource": "repo://lib/diagram.ts#L1-L19",
          "version": "repo-lines-v1:sha256:ee915ad54416e8cd5dc3d123e096993e62baaf4a30d68b2fa0e7c74962d132f1:"
        },
        {
