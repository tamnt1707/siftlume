          "version": "repo-lines-v1:sha256:4fcd3377f50a656f265287786eb6bbfcff7e35ec56a01efb8f8c28bc9ade37a9:"
        }
      ]
    },
    {
      "id": "claim_44bcc2e87a5140d1b5f836248e350b2f",
      "statement": "`renderDiagram` merges a fixed `BASE_OPTIONS` set (Bricolage Grotesque font family, `responsive: true`, `autoDirection: true`, `padding: 12`, `links: false`, `images: false`, `limit: 20_000`) with caller-supplied options before calling Pele's `renderAsync`.",
      "evidence": [
        {
          "resource": "repo://lib/diagram.ts#L28-L37",
          "version": "repo-lines-v1:sha256:4fcd3377f50a656f265287786eb6bbfcff7e35ec56a01efb8f8c28bc9ade37a9:"
