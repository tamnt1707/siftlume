        }
      ]
    },
    {
      "id": "claim_0a40339aab634dedb48668baf19c92fd",
      "statement": "Credentials are stored per provider in `Settings.providers` while `Settings.provider` is only a pointer, so switching providers preserves every already-entered key and model.",
      "evidence": [
        {
          "resource": "repo://lib/settings.ts#L143-L158",
          "version": "repo-lines-v1:sha256:a201d62da28572706ea9355538bc6cd16e5bbd49035aee98a0a280b708701fa9:"
        },
        {
          "resource": "repo://lib/settings.ts#L189-L205",
