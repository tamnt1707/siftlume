        }
      ]
    },
    {
      "id": "claim_1839049662824bb79eb8f13caf7ddf0b",
      "statement": "The whole settings object including API keys is persisted in `local:settings` (chrome.storage.local) and never in `sync:`, so keys are not synced through the browser account.",
      "evidence": [
        {
          "resource": "repo://lib/settings.ts#L216-L220",
