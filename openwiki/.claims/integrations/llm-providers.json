  "claims": [
    {
      "id": "claim_c7761118763c45efb532a390f975ca08",
      "statement": "The provider catalogue `PROVIDERS` maps twelve provider ids to presets that carry the API flavour, default base URL, suggested model, whether a key is required, and a `local` flag; `custom` is the only preset with an empty default base URL.",
      "evidence": [
        {
          "resource": "repo://lib/settings.ts#L14-L137",
          "version": "repo-lines-v1:sha256:bcaaa4f0c4fea49a93f38a559481a262c6bc8f515e02cccfd4596ff377b8bb3a:"
        }
      ]
    },
    {
      "id": "claim_c3c9d77769e94de3a4c31b5d54c0f059",
      "statement": "Provider calls are dispatched by four API flavours: `openai` uses the OpenAI Responses API, `anthropic` the Messages API, `google` the Gemini API, and `compatible` any OpenAI-compatible Chat Completions endpoint.",
      "evidence": [
        {
          "resource": "repo://lib/llm.ts#L10-L32",
          "version": "repo-lines-v1:sha256:bf2637d14a782e69347a29a0c658455265fd041ee4a997dd82cac9ca6f10edcc:"
        },
        {
          "resource": "repo://lib/settings.ts#L6-L12",
          "version": "repo-lines-v1:sha256:52c5ff8a2c9d542638377677525867e23447b887cd31ec7c660ced5b31f0f37f:"
        }
      ]
    },
    {
      "id": "claim_9d00f43922fb4e2aa2cf7d9c1364c2e0",
      "statement": "`createModel` builds the AI SDK provider per flavour and, for the `compatible` flavour, calls `.chat(p.model)` because OpenAI-compatible servers implement Chat Completions rather than the Responses API.",
      "evidence": [
        {
          "resource": "repo://lib/llm.ts#L10-L32",
          "version": "repo-lines-v1:sha256:bf2637d14a782e69347a29a0c658455265fd041ee4a997dd82cac9ca6f10edcc:"
        }
      ]
    },
    {
      "id": "claim_6d1cb3f8ce094f18ab87e73267ed46dc",
      "statement": "Anthropic requests carry the `anthropic-dangerous-direct-browser-access: true` header, which Anthropic requires when the API is called from a browser context.",
      "evidence": [
        {
          "resource": "repo://lib/llm.ts#L14-L21",
          "version": "repo-lines-v1:sha256:f059d0e995eadc2030e4d18779be0d722ff83156486ece788dccd50dbb3cf288:"
