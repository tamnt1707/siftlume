          "version": "repo-lines-v1:sha256:9538fdeac71a027240b8027bca27b6cb26f5b17381e1f6b538ecd00eaedf0e2c:"
        }
      ]
    },
    {
      "id": "claim_42e846eb5f834b87a7b1f5b20246dc71",
      "statement": "The library is deliberately created at module scope because parsers memoize by library identity; the parser in lib/openui.ts is built once from library.toJSONSchema() with ROOT, so rebuilding the library would rebuild the schema and parser with it.",
      "evidence": [
        {
          "resource": "repo://lib/library.tsx#L276-L282",
          "version": "repo-lines-v1:sha256:946e3e76b7e244caba88aaae113912e8f1c3f841938222596aa7755a01b762c4:"
