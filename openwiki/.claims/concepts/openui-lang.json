    },
    {
      "id": "claim_c5daa4d49ce147948bf57dc4c12d4518",
      "statement": "Each custom block declares the slots it may be placed in: SummaryHero only in Card.children, while KeyNumbers, Takeaways, Timeline, SourceQuote and Diagram are allowed in Card.children, SectionItem.content, TabItem.content and AccordionItem.content; KeyNumber, Takeaway and TimelineEvent are the children of those blocks and are not placed directly in the Card.",
      "evidence": [
