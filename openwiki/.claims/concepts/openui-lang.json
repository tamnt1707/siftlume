    {
      "id": "claim_65c44bc30c3640e999b3d2b62f54f1ef",
      "statement": "The summary system prompt is built in two halves: library.prompt() renders the language, component signatures, built-in actions and the edit-mode/inline-mode sections from the library (with editMode and inlineMode enabled and three extra worked examples), and a task half appends a bulleted rule list covering visual, chart, diagram, length, style, layout, per-source-kind and shared rules plus the user's output-language and custom-instruction rules.",
      "evidence": [
        {
          "resource": "repo://lib/openui.ts#L115-L147",
