    {
      "id": "claim_ffa45d193f4b471ea43afeff27c81131",
      "statement": "The app's OpenUI Lang component library is created by extending the upstream openuiChatLibrary with six custom summary components (SummaryHero, KeyNumbers, Takeaways, Timeline, SourceQuote, Diagram), three of their child components (KeyNumber, Takeaway, TimelineEvent) and two custom actions (HighlightInPage, CopyText), and the root component name is the string 'Card'.",
      "evidence": [
        {
          "resource": "repo://lib/library.tsx#L276-L300",
          "version": "repo-lines-v1:sha256:16aae8fb76046841b5ae952e2d41cfd8201b02aa8c0dc05d72669e3be0fcf8bf:"
        },
        {
