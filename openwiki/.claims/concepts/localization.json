    {
      "id": "claim_20c17cd4148e4e92b87a307397e40c8e",
      "statement": "The Interface language picker is the one setting that applies and persists immediately instead of waiting for Save, writing straight to `local:settings` through `settingsItem.setValue`, so the rest of the form is already readable in the new language.",
      "evidence": [
        {
          "resource": "repo://components/LanguagePicker.tsx#L8-L20",
          "version": "repo-lines-v1:sha256:11196f2564905ab196e6bc32bd61ecd795da98f06377ce0b3af995e8be6f4b10:"
