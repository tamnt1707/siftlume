    {
      "id": "claim_a3c499adcd87457d9d0bf46caff9906b",
      "statement": "`matchLanguage()` maps a BCP 47 tag to one of the supported codes, treating `zh-HK`/`zh-MO`/`Hant` as `zh-TW`, other `zh-*` as `zh-CN` and any `pt-*` as `pt-BR`; `browserLanguage()` prefers `browser.i18n.getUILanguage()` then `navigator.languages` and falls back to `en`, and `resolveUiLanguage()` turns the `\"auto\"` setting into a concrete language.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/index.ts#L41-L69",
          "version": "repo-lines-v1:sha256:0097045d49d9bf9f668ebfc1fe39608b7ab52753cba225cb501d0c27c6b93cf3:"
        }
      ]
    },
    {
      "id": "claim_b119351dbc754b5b869d735166629cd8",
      "statement": "`setUiLanguage()` changes the i18next language only when it actually differs and also sets `document.documentElement.lang` to the active language.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/index.ts#L83-L88",
          "version": "repo-lines-v1:sha256:6060c77e70d055262c778b83a3d29e586097b93bf5162c94e260f52a8435b3cb:"
        }
