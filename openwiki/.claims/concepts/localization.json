        }
      ]
    },
    {
      "id": "claim_b7344d6c6d594ceabf3a8fde685c742c",
      "statement": "`scripts/check-locales.mjs` (`pnpm check:i18n`) compares every non-English locale against English and fails with exit code 1 on key drift, wrong CLDR plural categories computed via `Intl.PluralRules`, mismatched `{{placeholders}}`, empty strings, or unexpected extra keys.",
      "evidence": [
        {
          "resource": "repo://scripts/check-locales.mjs#L1-L67",
          "version": "repo-lines-v1:sha256:c31830142657654d6a567a1b2d049db612ba25e918373368be75f7d66b0310cc:"
        }
      ]
    },
    {
      "id": "claim_c31c9e86ef2848ed89d220e2c2de5e2d",
      "statement": "The plural check requires each translated language to supply exactly the CLDR categories its own language needs — Russian must have `_one`, `_few`, `_many` and `_other`, English only `_one` and `_other`, French `_one`, `_many` and `_other` — while the check script covers only the `locales/` tree and not `public/_locales`.",
      "evidence": [
        {
          "resource": "repo://locales/fr/common.json#L26-L31",
          "version": "repo-lines-v1:sha256:d8d0dbb6e7be50a70d8ed8e96dd997d352a138e5242bb18ac334023730ef6b71:"
        },
