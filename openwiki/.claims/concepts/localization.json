    {
      "id": "claim_acc08171a44a41ea9f8627fa7ea578bf",
      "statement": "Only user-visible labels are translated: model-facing strings such as `REFINE_PROMPTS`, `STYLE_RULES` and the summary/Q&A prompt rules stay in English, while the refinement chip labels and tooltips come from the locale files.",
