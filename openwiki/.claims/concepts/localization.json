  "claims": [
    {
      "id": "claim_b644a04f04f24186baa8649bc6e7d196",
      "statement": "The extension has two independent localization systems: app UI strings in `locales/<lang>/<namespace>.json` read by i18next, and Chrome-level strings in `public/_locales/<lang>/messages.json` read by Chrome itself; the UI language follows the user's Interface-language setting while the Chrome-level strings follow only the browser locale.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/index.ts#L1-L12",
          "version": "repo-lines-v1:sha256:332efe29a98e1f0ec96467301a1c4b65bbc95b1b8ee81e755191ed57a7fd3e10:"
        },
        {
          "resource": "repo://public/_locales/en/messages.json#L1-L25",
          "version": "repo-lines-v1:sha256:97259e4482556fbddcb9f946fea9aa8eead7251c3d3d473e3a4833849311c3fe:"
        },
        {
          "resource": "repo://wxt.config.ts#L6-L28",
          "version": "repo-lines-v1:sha256:b362dd5fbf21fd00942a3bb4288f34d7c787f94a5bef759f5e7e31fe107cdda1:"
        }
      ]
    },
    {
      "id": "claim_b423259f8ea74429a219e8d54bf1c87d",
      "statement": "The app UI is organized as one folder per language under `locales/` with one JSON file per feature namespace, and the six namespaces are `common`, `picker`, `popup`, `session`, `settings` and `errors`, with `common` as the default namespace.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/index.ts#L29-L30",
          "version": "repo-lines-v1:sha256:7ec34f4e3ce65f908802c5e65e70809467b5c8f0ff1b90218867c60f4dfa2ce8:"
        },
        {
