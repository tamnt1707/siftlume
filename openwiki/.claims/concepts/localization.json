    {
      "id": "claim_3a4963a1e3d34511a750991e5f70ac92",
      "statement": "The Chrome-level tree `public/_locales/<lang>/messages.json` holds six keys — `extName`, `extDescription`, `actionTitle`, `commandOpen`, `menuSummarizePage` and `menuSummarizeSelection` — and the manifest references the first four through `__MSG_*__` placeholders with `default_locale: 'en'`.",
      "evidence": [
        {
          "resource": "repo://public/_locales/en/messages.json#L1-L25",
          "version": "repo-lines-v1:sha256:97259e4482556fbddcb9f946fea9aa8eead7251c3d3d473e3a4833849311c3fe:"
