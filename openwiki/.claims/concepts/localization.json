    {
      "id": "claim_0a0155c77d20476fa1a4f6016dfd533d",
      "statement": "`lib/i18n/types.d.ts` augments the `i18next` module with the types of the English JSON files, so a call such as `t('settings:model.load')` fails to compile when the key is absent from English — a missing English key is a compile error caught by `pnpm compile`, not a runtime surprise.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/types.d.ts#L1-L22",
          "version": "repo-lines-v1:sha256:934ca58c8a997813eea8c9b184ed8fc9f640208ee87724c876c5b7598b286252:"
        }
