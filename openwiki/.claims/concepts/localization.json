    {
      "id": "claim_5473302b855145bda7af8892a0792746",
      "statement": "The `public/_locales` directories use Chrome's underscore locale convention (`pt_BR`, `zh_CN`, `zh_TW`) while `locales/` uses BCP 47 hyphens (`pt-BR`, `zh-CN`, `zh-TW`); the two trees cover the same twelve languages but are maintained separately, with no script keeping them in sync.",
      "evidence": [
        {
          "resource": "repo://lib/i18n/index.ts#L13-L28",
          "version": "repo-lines-v1:sha256:84603267d326a5836acc2621d00ab30f00608c1c5a7e09a91b7b961d1d0047e7:"
