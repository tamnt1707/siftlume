    },
    {
      "id": "claim_11027799c28a4c8893dc62c886496ba7",
      "statement": "The two context-menu titles are read at runtime with `browser.i18n.getMessage(key) || fallback` in `lib/context-menus.ts`, so a missing key in a locale file still yields a usable English menu title.",
      "evidence": [
        {
          "resource": "repo://lib/context-menus.ts#L22-L40",
          "version": "repo-lines-v1:sha256:d8e93cba654d17d4a683ee293ecd7883b0ee983e26a33777b70a257a14ef6955:"
