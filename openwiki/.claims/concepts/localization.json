    {
      "id": "claim_ce414ce7348a47ce8a151973a9cfbca7",
      "statement": "Settings carries two distinct language fields: `uiLanguage` (the interface language, `\"auto\"` or one of the twelve codes) and `language` (the summary output language); the output language is not an i18next concern but a prompt rule sent to the model, with its own sixteen-entry `OUTPUT_LANGUAGES` list in the Settings form.",
      "evidence": [
        {
          "resource": "repo://components/SettingsForm.tsx#L33-L52",
          "version": "repo-lines-v1:sha256:04143dfae28de48cd3a2942ac70b454a6d4e8857096d01ae1cb8dc1cee7c948c:"
